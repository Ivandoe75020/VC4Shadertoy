<Window
    x:Class="VideoConverterForShadertoy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="90" />
                <Setter Property="Opacity" Value="0.6" />
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Opacity" Value="0.85" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="BarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PrimaryBarButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="200" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE714;" FontSize="13"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      VerticalAlignment="Center" />
            <TextBlock x:Name="AppTitleText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" Margin="20,8,20,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Width="360" Height="203" CornerRadius="6" Background="#FF000000">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                                <TextBlock x:Name="PreviewStatusText" Text="Load a shader to start the preview."
                                           Foreground="#B3FFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ShaderDetailsText" Grid.Row="1" Width="360" HorizontalAlignment="Left"
                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="12" RowSpacing="10" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="144" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="SOURCE" Style="{StaticResource SectionLabelStyle}" />

                        <Button x:Name="LoadJsonButton" Grid.Row="1" Grid.Column="0"
                                Style="{StaticResource ToolButtonStyle}" Click="LoadJsonButton_Click"
                                AutomationProperties.Name="Load JSON">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="16" Height="16" Source="ms-appx:///assets/icons/load-json.svg" />
                                <TextBlock Text="Load JSON" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ShaderNameText" Grid.Row="1" Grid.Column="1" Text="No shader loaded"
                                   VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                        <Button x:Name="LoadMp3Button" Grid.Row="2" Grid.Column="0"
                                Style="{StaticResource ToolButtonStyle}" Click="LoadMp3Button_Click"
                                AutomationProperties.Name="Load MP3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="16" Height="16" Source="ms-appx:///assets/icons/load-audio.svg" />
                                <TextBlock Text="Load MP3" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Mp3NameText" Grid.Column="0" VerticalAlignment="Center"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Button x:Name="RemoveMp3Button" Grid.Column="1" Style="{StaticResource ToolButtonStyle}"
                                    HorizontalAlignment="Right" Click="RemoveMp3Button_Click" Visibility="Collapsed"
                                    AutomationProperties.Name="Remove MP3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Width="16" Height="16" Source="ms-appx:///assets/icons/remove.svg" />
                                    <TextBlock Text="Remove" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1" Margin="0,4"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="EXPORT" Style="{StaticResource SectionLabelStyle}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Duration" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="DurationComboBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectedIndex="0" SelectionChanged="DurationComboBox_SelectionChanged">
                            <ComboBoxItem Content="60 seconds" />
                            <ComboBoxItem Content="90 seconds" />
                            <ComboBoxItem Content="120 seconds" />
                        </ComboBox>
                        <TextBlock x:Name="Mp3DurationText" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Resolution" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="ResolutionComboBox" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectedIndex="0" SelectionChanged="ResolutionComboBox_SelectionChanged">
                            <ComboBoxItem Content="720p (1280 × 720)" />
                            <ComboBoxItem Content="1080p (1920 × 1080)" />
                        </ComboBox>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Frame rate" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="FrameRateComboBox" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectedIndex="0" SelectionChanged="FrameRateComboBox_SelectionChanged">
                            <ComboBoxItem Content="30 fps" />
                            <ComboBoxItem Content="60 fps" />
                        </ComboBox>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,12">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                        <ProgressBar x:Name="ExportProgressBar" Minimum="0" Maximum="100" Value="0"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="ExportProgressText" Style="{StaticResource CaptionTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="OpenFolderButton" Style="{StaticResource BarButtonStyle}"
                                Click="OpenFolderButton_Click" Visibility="Collapsed"
                                AutomationProperties.Name="Open folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="16" Height="16" Source="ms-appx:///assets/icons/open-folder.svg" />
                                <TextBlock Text="Open folder" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenVideoButton" Style="{StaticResource BarButtonStyle}"
                                Click="OpenVideoButton_Click" Visibility="Collapsed"
                                AutomationProperties.Name="Open video">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="16" Height="16" Source="ms-appx:///assets/icons/open-video.svg" />
                                <TextBlock Text="Open video" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelExportButton" Style="{StaticResource BarButtonStyle}"
                                Click="CancelExportButton_Click" Visibility="Collapsed"
                                AutomationProperties.Name="Cancel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="16" Height="16" Source="ms-appx:///assets/icons/cancel.svg" />
                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportButton" Style="{StaticResource PrimaryBarButtonStyle}"
                                Click="ExportButton_Click" IsEnabled="False"
                                AutomationProperties.Name="Export video as MP4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="18" Height="18" Source="ms-appx:///assets/icons/export-video.svg" />
                                <TextBlock Text="Export video as MP4" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="22,0">
            <TextBlock Text="Copyright © Asger Andersen" Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock Text="Turn Shadertoy shaders into MP4 videos." Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="0" Grid.RowSpan="3" Canvas.ZIndex="10"
                 VerticalAlignment="Top" Margin="20,40,20,0" IsOpen="False" IsClosable="True" />
    </Grid>
</Window>
